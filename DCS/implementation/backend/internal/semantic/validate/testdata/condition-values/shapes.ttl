@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcs:  <https://projects.eclipse.org/xfsc/facis/dcs#> .

dcs:ValidityPeriodShape
  a sh:NodeShape ;
  sh:targetClass dcs:ValidityPeriod ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path dcs:startDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path dcs:endDate ;
    sh:datatype xsd:date ;
  ] .

dcs:PaymentTermsShape
  a sh:NodeShape ;
  sh:targetClass dcs:PaymentTerms ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path dcs:rentAmount ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path dcs:currency ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path dcs:dueDayOfMonth ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
  ] .

dcs:DataAccessScopeShape
  a sh:NodeShape ;
  sh:targetClass dcs:DataAccessScope ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path dcs:region ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] .
