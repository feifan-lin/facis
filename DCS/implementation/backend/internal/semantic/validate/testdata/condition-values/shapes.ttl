@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcs:  <https://projects.eclipse.org/xfsc/facis/dcs#> .

dcs:ValidityPeriodShape
  a sh:NodeShape ;
  sh:targetClass dcs:ValidityPeriod ;
  sh:property [
    sh:path dcs:startDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path dcs:endDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
  ] .
